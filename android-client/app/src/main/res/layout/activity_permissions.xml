<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian"
    android:padding="32dp">

    <!-- Top marker line: Signal Orange accent bar -->
    <View
        android:id="@+id/accentBar"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/signal_orange"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- App name: monospace, small, muted -->
    <TextView
        android:id="@+id/tvAppLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="LINTAB v0.1"
        android:textColor="#767676"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/accentBar"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Section header: "ACCESO REQUERIDO" -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="ACCESO\nREQUERIDO."
        android:textColor="@color/paper_white"
        android:textSize="36sp"
        android:fontFamily="sans-serif-black"
        android:textStyle="bold"
        android:lineSpacingMultiplier="0.92"
        app:layout_constraintTop_toBottomOf="@id/tvAppLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Subtitle description -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="LinTab necesita descubrir el daemon en tu red local para transmitir la entrada del stylus."
        android:textColor="#767676"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="28dp"
        android:background="#1A1A1A"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Permission item: NEARBY_WIFI / LOCATION -->
    <LinearLayout
        android:id="@+id/permNetwork"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Status dot -->
        <View
            android:id="@+id/dotNetwork"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/shape_circle_orange"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPOSITIVOS EN RED"
                android:textColor="@color/paper_white"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="NEARBY_WIFI_DEVICES · ACCESS_FINE_LOCATION"
                android:textColor="#767676"
                android:textSize="9sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Status text (PENDIENTE / CONCEDIDO) -->
        <TextView
            android:id="@+id/tvNetworkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDIENTE"
            android:textColor="@color/signal_orange"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- Permission item: INTERNET -->
    <LinearLayout
        android:id="@+id/permInternet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/permNetwork"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/shape_circle_orange"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESO A INTERNET"
                android:textColor="@color/paper_white"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="INTERNET · ACCESS_NETWORK_STATE"
                android:textColor="#767676"
                android:textSize="9sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NORMAL"
            android:textColor="#767676"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <!-- Privacy note -->
    <TextView
        android:id="@+id/tvPrivacyNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="// Los permisos de red son necesarios exclusivamente para descubrir el daemon LinTab en la red local (mDNS). No se recopilan ni transmiten datos a servidores externos."
        android:textColor="#3A3A3A"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintTop_toBottomOf="@id/permInternet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Spacer to push button to bottom -->
    <View
        android:id="@+id/spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvPrivacyNote"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintHeight_min="24dp"/>

    <!-- Primary CTA button -->
    <TextView
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:background="@color/signal_orange"
        android:gravity="center"
        android:text="CONCEDER ACCESO_"
        android:textColor="@color/obsidian"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/btnSkip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Secondary skip link -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="CONTINUAR SIN PERMISOS"
        android:textColor="#767676"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
