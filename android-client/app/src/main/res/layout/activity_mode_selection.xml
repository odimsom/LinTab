<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- Logo / título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LINTAB"
            android:textColor="@color/signal_orange"
            android:textSize="36sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.4"
            android:layout_marginTop="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECCIONA UN MODO"
            android:textColor="@color/paper_white"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp" />

        <!-- Modo Dibujo -->
        <LinearLayout
            android:id="@+id/cardDrawing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_mode_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01. MODO DIBUJO"
                android:textColor="@color/signal_orange"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Posición absoluta, compensación máxima.\nIdeal para ilustración y arte digital."
                android:textColor="@color/paper_white"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

        <!-- Modo Apuntes -->
        <LinearLayout
            android:id="@+id/cardNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_mode_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02. MODO APUNTES"
                android:textColor="@color/signal_orange"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Absoluto con suavizado moderado.\nOptimizado para escritura y diagramas."
                android:textColor="@color/paper_white"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

        <!-- Modo Touchpad -->
        <LinearLayout
            android:id="@+id/cardTouchpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_mode_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03. MODO TOUCHPAD"
                android:textColor="@color/signal_orange"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movimiento relativo tipo ratón.\nIdeal para navegación y control general."
                android:textColor="@color/paper_white"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

        <!-- Auto detectar -->
        <LinearLayout
            android:id="@+id/cardAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_mode_highlight_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04. AUTO DETECTAR HARDWARE"
                android:textColor="@color/obsidian"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calibra automáticamente según tu dispositivo.\nRecomendado para tablets antiguas."
                android:textColor="@color/obsidian"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puedes cambiar el modo desde ⚙ dentro de la app."
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
