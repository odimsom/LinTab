  Adaptive icon foreground — tablet + stylus mark in Signal Orange / Paper White
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tablet outline -->
    <path
        android:strokeColor="#FF4F00"
        android:strokeWidth="3"
        android:fillColor="@android:color/transparent"
        android:pathData="M18,22 L90,22 L90,78 L18,78 Z"/>

    <!-- Coordinate grid line 1 -->
    <path
        android:strokeColor="#FF4F00"
        android:strokeWidth="0.5"
        android:strokeAlpha="0.22"
        android:pathData="M21,40 L87,40"/>

    <!-- Coordinate grid line 2 -->
    <path
        android:strokeColor="#FF4F00"
        android:strokeWidth="0.5"
        android:strokeAlpha="0.22"
        android:pathData="M21,60 L87,60"/>

    <!-- Stylus shaft -->
    <path
        android:strokeColor="#FF4F00"
        android:strokeWidth="4.5"
        android:strokeLineCap="square"
        android:pathData="M97,10 L67,40"/>

    <!-- Stylus nib -->
    <path
        android:fillColor="#F4F1EA"
        android:pathData="M67,40 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"/>

    <!-- "L" letterform -->
    <path
        android:strokeColor="#F4F1EA"
        android:strokeWidth="5"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="@android:color/transparent"
        android:pathData="M30,61 L30,74 L43,74"/>

    <!-- "T" letterform -->
    <path
        android:strokeColor="#F4F1EA"
        android:strokeWidth="5"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="@android:color/transparent"
        android:pathData="M52,61 L76,61 M64,61 L64,74"/>

    <!-- Signal indicator: orange block, bottom-right of tablet -->
    <path
        android:fillColor="#FF4F00"
        android:pathData="M84,71 L90,71 L90,78 L84,78 Z"/>

</vector>
