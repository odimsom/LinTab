<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal permissions (granted at install) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Runtime permissions for mDNS/NSD discovery -->
    <!-- API 33+: replaces ACCESS_FINE_LOCATION for WiFi scanning -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- API 31-32: required for NSD/mDNS network scanning -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Instalar el APK de actualización descargado dentro de la app
         (Android 8+ pide este permiso especial para lanzar el instalador
         desde una app propia). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LinTab">

        <!-- Entry point: permissions gate -->
        <activity
            android:name=".ui.PermissionsActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mode selection (first run) -->
        <activity
            android:name=".ui.ModeSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Hardware benchmark & calibration -->
        <activity
            android:name=".ui.BenchmarkActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Main drawing canvas -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Expone el APK descargado en caché al instalador del sistema
             vía content:// URI (necesario desde Android 7+). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
